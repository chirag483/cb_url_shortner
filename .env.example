# Copy this file to .env and adjust for your environment.
# docker-compose reads these directly; the app container gets the
# URLSHORT_* variables mapped for it in docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener
POSTGRES_PORT=5432

# --- App ---
APP_PORT=8000
BASE_URL=http://localhost:8000
SHORT_CODE_LENGTH=7
UNLOGGED_TABLE=true
CACHE_MAX_SIZE=10000
HIT_FLUSH_INTERVAL_SECONDS=2.0

# If running app.py directly (outside docker-compose), set this instead:
# URLSHORT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener
